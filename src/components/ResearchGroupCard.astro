---
import type { CollectionEntry } from 'astro:content';
import { withBase } from '../lib/url';

interface Props {
	group: CollectionEntry<'groupes'>;
}

const { group } = Astro.props;
---

<a class="card" href={withBase(`/recherche/${group.id}/`)}>
	{
		group.data.image && (
			<div class="card-media">
				<img src={withBase(group.data.image)} alt="" loading="lazy" />
			</div>
		)
	}
	<div class="card-body">
		<span class="eyebrow">Groupe de recherche</span>
		<h3>{group.data.title}</h3>
		{group.data.intro && <p>{group.data.intro}</p>}
	</div>
</a>
