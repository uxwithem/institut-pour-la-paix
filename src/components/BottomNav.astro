---
import { withBase } from '../lib/url';

const icons: Record<string, string> = {
	book: '<svg viewBox="0 0 24 24" width="21" height="21" aria-hidden="true"><path d="M4 5.5C4 4.67 4.67 4 5.5 4H12v16H5.5A1.5 1.5 0 0 1 4 18.5v-13Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M20 5.5C20 4.67 19.33 4 18.5 4H12v16h6.5a1.5 1.5 0 0 0 1.5-1.5v-13Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>',
	news: '<svg viewBox="0 0 24 24" width="21" height="21" aria-hidden="true"><rect x="3.5" y="5" width="17" height="14" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M7 9h6M7 12.5h6M7 16h3.5M15.5 9v7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>',
	calendar: '<svg viewBox="0 0 24 24" width="21" height="21" aria-hidden="true"><rect x="3.5" y="5.5" width="17" height="15" rx="2" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M3.5 9.5h17M8 3.5v4M16 3.5v4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>',
	layers: '<svg viewBox="0 0 24 24" width="21" height="21" aria-hidden="true"><path d="M12 3.5 20.5 8 12 12.5 3.5 8 12 3.5Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M3.5 12.5 12 17l8.5-4.5M3.5 16.5 12 21l8.5-4.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>',
	users: '<svg viewBox="0 0 24 24" width="21" height="21" aria-hidden="true"><circle cx="9" cy="8" r="3" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M3.5 19c.7-3.2 3-5 5.5-5s4.8 1.8 5.5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><path d="M15.5 6.2c1.4.3 2.5 1.6 2.5 3.1 0 1.5-1 2.7-2.3 3.1M18 14.4c1.9.6 3.3 2.2 3.7 4.6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>',
};

const items = [
	{ label: 'Recherche', url: '/recherche/', icon: 'book' },
	{ label: 'Actualités', url: '/actualites/', icon: 'news' },
	{ label: 'Agenda', url: '/agenda/', icon: 'calendar' },
	{ label: 'Ressources', url: '/ressources/', icon: 'layers' },
	{ label: 'Réseau', url: '/equipe-reseau/', icon: 'users' },
];

const currentPath = Astro.url.pathname;
function isActive(url: string): boolean {
	const target = withBase(url);
	return currentPath === target || currentPath.startsWith(target);
}
---

<nav class="bottom-nav" aria-label="Navigation principale">
	<ul>
		{
			items.map((item) => (
				<li>
					<a href={withBase(item.url)} aria-current={isActive(item.url) ? 'page' : undefined}>
						<span class="icon" set:html={icons[item.icon]} />
						{item.label}
					</a>
				</li>
			))
		}
	</ul>
</nav>

<style>
	.bottom-nav {
		position: fixed;
		inset-inline: 0;
		bottom: 0;
		z-index: 30;
		background: color-mix(in srgb, var(--color-surface) 85%, transparent);
		backdrop-filter: blur(14px) saturate(1.6);
		-webkit-backdrop-filter: blur(14px) saturate(1.6);
		border-top: 1px solid var(--color-line);
		padding-bottom: env(safe-area-inset-bottom, 0);
	}

	ul {
		list-style: none;
		margin: 0;
		padding: 0.35rem 0.4rem 0.3rem;
		display: grid;
		grid-template-columns: repeat(5, 1fr);
		gap: 0.25rem;
	}

	a {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.15rem;
		padding-block: 0.4rem;
		border-radius: 0.9rem;
		font-family: var(--font-mono);
		font-size: 0.6rem;
		text-transform: uppercase;
		letter-spacing: 0.03em;
		font-weight: 500;
		color: var(--color-muted);
		text-decoration: none;
	}

	.icon {
		display: flex;
		line-height: 0;
	}

	@media (prefers-reduced-motion: no-preference) {
		a {
			transition:
				color 0.15s ease,
				background-color 0.15s ease;
		}
	}

	a[aria-current='page'] {
		color: var(--color-accent);
		background: color-mix(in srgb, var(--color-accent) 12%, transparent);
	}

	@media (min-width: 48rem) {
		.bottom-nav {
			display: none;
		}
	}
</style>
