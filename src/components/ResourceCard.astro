---
import { getEntry, type CollectionEntry } from 'astro:content';
import { withBase } from '../lib/url';

interface Props {
	resource: CollectionEntry<'ressources'>;
}

const { resource } = Astro.props;
const type = await getEntry('resourceTypes', resource.data.type);
---

<a class="card" href={withBase(`/ressources/${resource.id}/`)}>
	{
		resource.data.thumbnail && (
			<div class="card-media">
				<img src={withBase(resource.data.thumbnail)} alt="" loading="lazy" />
			</div>
		)
	}
	<div class="card-body">
		<span class="eyebrow">{type?.data.label ?? resource.data.type}</span>
		<h3>{resource.data.title}</h3>
		{resource.data.description && <p>{resource.data.description}</p>}
	</div>
</a>
