---
import type { CollectionEntry } from 'astro:content';
import { withBase } from '../lib/url';

interface Props {
	article: CollectionEntry<'actualites'>;
}

const { article } = Astro.props;
const dateLabel = article.data.date.toLocaleDateString('fr-FR', {
	day: 'numeric',
	month: 'long',
	year: 'numeric',
});
---

<a class="card" href={withBase(`/actualites/${article.id}/`)}>
	{
		article.data.featuredImage && (
			<div class="card-media">
				<img src={withBase(article.data.featuredImage)} alt="" loading="lazy" />
			</div>
		)
	}
	<div class="card-body">
		<span class="eyebrow">{dateLabel}</span>
		<h3>{article.data.title}</h3>
		{article.data.excerpt && <p>{article.data.excerpt}</p>}
	</div>
</a>
