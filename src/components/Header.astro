---
import { getEntry } from 'astro:content';
import { withBase } from '../lib/url';

const settings = await getEntry('siteSettings', 'main');
const nav = await getEntry('navigation', 'main');
---

<header class="site-header">
	<div class="wrap bar">
		<a class="brand" href={withBase('/')}>{settings?.data.siteName}</a>
		<nav class="top-nav" aria-label="Navigation principale">
			<ul>
				{
					nav?.data.items.map((item) => (
						<li>
							<a href={withBase(item.url)}>{item.label}</a>
						</li>
					))
				}
			</ul>
		</nav>
		<div class="actions">
			<a class="search-link" href={withBase('/rechercher/')} aria-label="Rechercher">
				<svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
					<circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2" />
					<line x1="21" y1="21" x2="16.65" y2="16.65" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
				</svg>
			</a>
			<a class="btn join" href={withBase('/devenir-membre/')}>Devenir membre</a>
		</div>
	</div>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 20;
		border-bottom: 1px solid var(--color-line);
		background: var(--color-surface);
		padding-top: env(safe-area-inset-top, 0);
	}

	.bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding-block: 0.9rem;
	}

	.brand {
		display: block;
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 1.25rem;
		letter-spacing: -0.01em;
		color: var(--color-fg);
		text-decoration: none;
	}

	.top-nav {
		display: none;
	}

	.actions {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	.search-link {
		display: flex;
		color: var(--color-fg);
		padding: 0.4rem;
	}

	.search-link:hover {
		color: var(--color-accent);
	}

	.join {
		padding: 0.55rem 1rem;
		font-size: 0.82rem;
	}

	@media (min-width: 48rem) {
		.top-nav {
			display: block;
		}

		.top-nav ul {
			list-style: none;
			margin: 0;
			padding: 0;
			display: flex;
			flex-wrap: wrap;
			gap: 1.5rem;
		}

		.top-nav a {
			color: var(--color-fg);
			font-weight: 500;
			font-size: 0.92rem;
			text-decoration: none;
		}

		.top-nav a:hover {
			color: var(--color-accent);
		}
	}
</style>
