---
import { getEntry } from 'astro:content';
import { withBase } from '../lib/url';

const settings = await getEntry('siteSettings', 'main');
const nav = await getEntry('navigation', 'main');

const currentPath = Astro.url.pathname;
function isActive(url: string): boolean {
	const target = withBase(url);
	return currentPath === target || currentPath.startsWith(target);
}
---

<header class="site-header">
	<div class="wrap bar">
		<a class="brand" href={withBase('/')}>{settings?.data.siteName}</a>
		<nav class="top-nav" aria-label="Navigation principale">
			<ul>
				{
					nav?.data.items.map((item) => (
						<li>
							<a href={withBase(item.url)} aria-current={isActive(item.url) ? 'page' : undefined}>
								{item.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>
		<div class="actions">
			<a class="search-link" href={withBase('/rechercher/')} aria-label="Rechercher">
				<svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
					<circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2" />
					<line x1="21" y1="21" x2="16.65" y2="16.65" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
				</svg>
			</a>
			<a class="btn join" href={withBase('/devenir-membre/')}>Adhérer</a>
		</div>
	</div>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 20;
		border-bottom: 1px solid var(--color-line);
		background: color-mix(in srgb, var(--color-surface) 82%, transparent);
		backdrop-filter: blur(14px) saturate(1.6);
		-webkit-backdrop-filter: blur(14px) saturate(1.6);
		padding-top: env(safe-area-inset-top, 0);
	}

	.bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.6rem;
		padding-block: 0.8rem;
	}

	.brand {
		display: block;
		flex: 1 1 auto;
		min-width: 0;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
		font-family: var(--font-display);
		font-weight: 600;
		font-size: clamp(0.9rem, 4.6vw, 1.25rem);
		letter-spacing: -0.01em;
		color: var(--color-fg);
		text-decoration: none;
	}

	.top-nav {
		display: none;
	}

	.actions {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		flex: none;
	}

	.search-link {
		display: flex;
		color: var(--color-fg);
		padding: 0.4rem;
	}

	.search-link:hover {
		color: var(--color-accent);
	}

	.join {
		padding: 0.55rem 0.9rem;
		font-size: 0.78rem;
		white-space: nowrap;
	}

	@media (min-width: 26rem) {
		.join {
			padding: 0.55rem 1rem;
			font-size: 0.82rem;
		}
	}

	@media (min-width: 48rem) {
		.top-nav {
			display: block;
		}

		.top-nav ul {
			list-style: none;
			margin: 0;
			padding: 0;
			display: flex;
			flex-wrap: wrap;
			gap: 1.5rem;
		}

		.top-nav a {
			position: relative;
			color: var(--color-fg);
			font-weight: 500;
			font-size: 0.92rem;
			text-decoration: none;
			padding-bottom: 0.3rem;
		}

		.top-nav a:hover {
			color: var(--color-accent);
		}

		.top-nav a[aria-current='page'] {
			color: var(--color-accent);
		}

		.top-nav a[aria-current='page']::after {
			content: '';
			position: absolute;
			left: 0;
			right: 0;
			bottom: 0;
			height: 2px;
			background: var(--color-accent);
		}
	}
</style>
