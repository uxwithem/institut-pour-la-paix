---
import { getEntry } from 'astro:content';
import { withBase } from '../lib/url';

const settings = await getEntry('siteSettings', 'main');
const footer = await getEntry('footer', 'main');
const social = await getEntry('socialLinks', 'main');
const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="wrap grid">
		<div class="about">
			{
				settings?.data.logo ? (
					<img class="footer-logo" src={withBase(settings.data.logo)} alt={settings.data.siteName} />
				) : (
					<p class="wordmark">{footer?.data.text}</p>
				)
			}
			{
				social?.data.items.length ? (
					<ul class="social">
						{social.data.items.map((item) => (
							<li>
								<a href={item.url} rel="noopener noreferrer" target="_blank">
									{item.platform}
								</a>
							</li>
						))}
					</ul>
				) : null
			}
		</div>
		{
			footer?.data.columns.map((column) => (
				<div class="col">
					<p class="eyebrow">{column.title}</p>
					<ul>
						{column.links.map((link) => (
							<li>
								<a href={withBase(link.url)}>{link.label}</a>
							</li>
						))}
					</ul>
				</div>
			))
		}
	</div>
	<div class="wrap copyright">
		<p>&copy; {year} {footer?.data.text}</p>
	</div>
</footer>

<style>
	/* An intentionally-inverted section: swap fg/bg rather than introduce a new
	   color, so it stays dark-on-light-page in light mode and light-on-dark-page
	   in dark mode — always the opposite of the surrounding page, on purpose. */
	.site-footer {
		background: var(--gradient-ink);
		color: var(--color-bg);
		margin-top: var(--space-5);
	}

	.site-footer :focus-visible {
		outline-color: var(--color-accent);
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
		gap: var(--space-4);
		padding-block: var(--space-4);
	}

	.wordmark {
		font-family: var(--font-display);
		font-size: 1.15rem;
		margin: 0 0 0.75rem;
	}

	.footer-logo {
		height: 2.75rem;
		width: auto;
		margin-bottom: 0.9rem;
		/* Light theme: footer bg is near-black, so invert the dark-ink logo to
		   read white. Dark theme: footer bg is near-white, so its natural dark
		   ink already reads fine — no invert. */
		filter: brightness(0) invert(1);
		opacity: 0.92;
	}

	@media (prefers-color-scheme: dark) {
		.footer-logo {
			filter: none;
		}
	}

	.eyebrow {
		color: color-mix(in srgb, var(--color-bg) 70%, var(--color-fg));
	}

	.eyebrow::before {
		background: var(--color-accent);
	}

	.col ul {
		margin-top: 0.9rem;
	}

	ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.col a {
		color: color-mix(in srgb, var(--color-bg) 88%, var(--color-fg));
	}

	.col a:hover {
		color: var(--color-accent);
	}

	.social {
		flex-direction: row;
		gap: 1.25rem;
		margin-top: 0.75rem;
	}

	.social a {
		color: color-mix(in srgb, var(--color-bg) 70%, var(--color-fg));
	}

	.social a:hover {
		color: var(--color-accent);
	}

	.copyright {
		border-top: 1px solid color-mix(in srgb, var(--color-bg) 15%, transparent);
		padding-block: 1.1rem;
		font-size: 0.82rem;
		color: color-mix(in srgb, var(--color-bg) 55%, var(--color-fg));
	}
</style>
