---
import { getEntry } from 'astro:content';
import { withBase } from '../lib/url';

const footer = await getEntry('footer', 'main');
const social = await getEntry('socialLinks', 'main');
const newsletter = await getEntry('newsletter', 'main');
const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="wrap grid">
		<div class="about">
			<p class="wordmark">{footer?.data.text}</p>
			{
				social?.data.items.length ? (
					<ul class="social">
						{social.data.items.map((item) => (
							<li>
								<a href={item.url} rel="noopener noreferrer" target="_blank">
									{item.platform}
								</a>
							</li>
						))}
					</ul>
				) : null
			}
		</div>
		{
			footer?.data.columns.map((column) => (
				<div class="col">
					<p class="eyebrow">{column.title}</p>
					<ul>
						{column.links.map((link) => (
							<li>
								<a href={withBase(link.url)}>{link.label}</a>
							</li>
						))}
					</ul>
				</div>
			))
		}
		{
			newsletter && (newsletter.data.heading || newsletter.data.description) && (
				<div class="col">
					<p class="eyebrow">{newsletter.data.heading}</p>
					<p>{newsletter.data.description}</p>
				</div>
			)
		}
	</div>
	<div class="wrap copyright">
		<p>&copy; {year} {footer?.data.text}</p>
	</div>
</footer>

<style>
	.site-footer {
		background: var(--color-indigo-deep);
		color: #fff;
		margin-top: var(--space-5);
	}

	.site-footer :focus-visible {
		outline-color: var(--color-signal-bright);
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
		gap: var(--space-4);
		padding-block: var(--space-4);
	}

	.wordmark {
		font-family: var(--font-display);
		font-size: 1.15rem;
		margin: 0 0 0.75rem;
	}

	.eyebrow {
		color: #cfccee;
	}

	.eyebrow::before {
		background: var(--color-signal-bright);
	}

	.col ul {
		margin-top: 0.9rem;
	}

	ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.col a {
		color: #ece9fb;
	}

	.col a:hover {
		color: var(--color-signal-bright);
	}

	.social {
		flex-direction: row;
		gap: 1.25rem;
		margin-top: 0.75rem;
	}

	.social a {
		color: #cfccee;
	}

	.social a:hover {
		color: var(--color-signal-bright);
	}

	.copyright {
		border-top: 1px solid rgba(255, 255, 255, 0.15);
		padding-block: 1.1rem;
		font-size: 0.82rem;
		color: #a9a5d1;
	}
</style>
