---
import { withBase } from '../lib/url';

interface Crumb {
	label: string;
	url?: string;
}

interface Props {
	items: Crumb[];
}

const { items } = Astro.props;
---

<nav class="breadcrumb" aria-label="Fil d'Ariane">
	<div class="wrap">
		<ol>
			<li>
				<a href={withBase('/')}>Accueil</a>
			</li>
			{
				items.map((item, i) => (
					<li>
						{item.url && i < items.length - 1 ? (
							<a href={withBase(item.url)}>{item.label}</a>
						) : (
							<span aria-current="page">{item.label}</span>
						)}
					</li>
				))
			}
		</ol>
	</div>
</nav>

<style>
	.breadcrumb {
		border-bottom: 1px solid var(--color-line);
	}

	ol {
		list-style: none;
		margin: 0;
		padding: 0.75rem 0;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.4rem;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		text-transform: uppercase;
		letter-spacing: 0.04em;
	}

	li {
		display: flex;
		align-items: center;
		gap: 0.4rem;
	}

	li:not(:first-child)::before {
		content: '/';
		color: var(--color-line);
	}

	a {
		color: var(--color-muted);
		text-decoration: none;
	}

	a:hover {
		color: var(--color-accent);
	}

	[aria-current='page'] {
		color: var(--color-fg);
		font-weight: 600;
	}
</style>
