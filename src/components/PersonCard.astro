---
import type { CollectionEntry } from 'astro:content';
import { withBase } from '../lib/url';

interface Props {
	person: CollectionEntry<'personnes'>;
}

const { person } = Astro.props;

const typeLabels: Record<string, string> = {
	equipe: 'Équipe',
	copil: 'Comité de pilotage',
	'membre-reseau': 'Réseau IPP',
	chercheur: 'Chercheur associé',
	partenaire: 'Partenaire',
};
---

<a class="card" href={withBase(`/equipe-reseau/${person.id}/`)}>
	{
		person.data.photo && (
			<div class="card-media card-media--portrait">
				<img src={withBase(person.data.photo)} alt="" loading="lazy" />
			</div>
		)
	}
	<div class="card-body">
		<span class="eyebrow">{typeLabels[person.data.type] ?? person.data.type}</span>
		<h3>{person.data.name}</h3>
		{person.data.role && <p class="meta">{person.data.role}</p>}
	</div>
</a>
