---
import { withBase } from '../lib/url';

interface Item {
	label: string;
	url: string;
}

interface Props {
	items: Item[];
}

const { items } = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';

function isActive(url: string): boolean {
	const target = withBase(url).replace(/\/$/, '') || '/';
	return currentPath === target;
}
---

<nav class="filter-tabs" aria-label="Filtrer">
	<ul>
		{
			items.map((item) => (
				<li>
					<a href={withBase(item.url)} aria-current={isActive(item.url) ? 'page' : undefined}>
						{item.label}
					</a>
				</li>
			))
		}
	</ul>
</nav>

<style>
	.filter-tabs {
		margin-block: 1.25rem 0.5rem;
		overflow-x: auto;
	}

	ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		gap: 0.5rem;
		width: max-content;
	}

	a {
		display: block;
		font-family: var(--font-mono);
		font-size: 0.78rem;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		font-weight: 500;
		color: var(--color-fg);
		border: 1px solid var(--color-line);
		border-radius: 999px;
		padding: 0.5rem 1rem;
		text-decoration: none;
		white-space: nowrap;
	}

	a:hover {
		border-color: var(--color-accent);
		color: var(--color-accent);
	}

	a[aria-current='page'] {
		background: var(--color-accent);
		border-color: var(--color-accent);
		color: #fff;
	}

	a[aria-current='page']:hover {
		color: #fff;
	}
</style>
