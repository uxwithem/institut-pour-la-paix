---
import { getEntry } from 'astro:content';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BottomNav from '../components/BottomNav.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { withBase } from '../lib/url';
import '../styles/global.css';

interface Crumb {
	label: string;
	url?: string;
}

interface Props {
	title: string;
	description?: string;
	breadcrumb?: Crumb[];
}

const { title, description, breadcrumb } = Astro.props;
const seo = await getEntry('seoDefaults', 'main');
const settings = await getEntry('siteSettings', 'main');

const pageTitle = seo?.data.titleTemplate ? seo.data.titleTemplate.replace('%s', title) : title;
const pageDescription = description ?? seo?.data.defaultDescription;
---

<html lang="fr">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{pageTitle}</title>
		{pageDescription && <meta name="description" content={pageDescription} />}
		<meta name="generator" content={Astro.generator} />
		{
			settings?.data.favicon && (
				<>
					<link rel="icon" href={withBase(settings.data.favicon)} />
					<link rel="apple-touch-icon" href={withBase(settings.data.favicon)} />
				</>
			)
		}
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<Header />
		{breadcrumb && breadcrumb.length > 0 && <Breadcrumb items={breadcrumb} />}
		<main>
			<slot />
		</main>
		<Footer />
		<BottomNav />
	</body>
</html>
