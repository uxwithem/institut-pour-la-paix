---
import { getCollection, getEntries, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PublicationCard from '../../components/PublicationCard.astro';
import { withBase } from '../../lib/url';

export async function getStaticPaths() {
	const people = await getCollection('personnes');
	return people.map((person) => ({
		params: { slug: person.id },
		props: { person },
	}));
}

const { person } = Astro.props;
const { Content } = await render(person);
const publications = await getEntries(person.data.publications);

const initials = person.data.name
	.split(/\s+/)
	.map((w) => w[0])
	.slice(0, 2)
	.join('')
	.toUpperCase();
---

<BaseLayout
	title={person.data.name}
	breadcrumb={[{ label: 'Équipe et réseau', url: '/equipe-reseau/' }, { label: person.data.name }]}
>
	<article class="section wrap-article">
		<div class="profile-header">
			<div class="avatar">
				{
					person.data.photo ? (
						<img src={withBase(person.data.photo)} alt="" />
					) : (
						<span class="initials">{initials}</span>
					)
				}
			</div>
			<div>
				<h1>{person.data.name}</h1>
				{person.data.role && <p class="meta">{person.data.role}{person.data.organization && ` · ${person.data.organization}`}</p>}
				<ul class="links">
					{person.data.email && <li><a href={`mailto:${person.data.email}`}>Email</a></li>}
					{person.data.website && <li><a href={person.data.website}>Site web</a></li>}
					{person.data.linkedin && <li><a href={person.data.linkedin}>LinkedIn</a></li>}
				</ul>
			</div>
		</div>

		{
			person.data.researchInterests.length > 0 && (
				<ul class="interests">
					{person.data.researchInterests.map((interest) => (
						<li>{interest}</li>
					))}
				</ul>
			)
		}

		<div class="prose">
			<Content />
		</div>
	</article>

	{
		publications.length > 0 && (
			<section class="section wrap">
				<h2>Publications</h2>
				<div class="card-grid">
					{publications.map((publication) => (
						<PublicationCard publication={publication} />
					))}
				</div>
			</section>
		)
	}
</BaseLayout>

<style>
	.profile-header {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 1.5rem;
		margin-bottom: 1.5rem;
	}

	.avatar {
		flex: none;
		width: 7rem;
		height: 7rem;
		border-radius: 50%;
		overflow: hidden;
		background: color-mix(in srgb, var(--color-fg) 8%, var(--color-bg));
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.avatar img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.initials {
		font-family: var(--font-display);
		font-size: 2.1rem;
		font-weight: 600;
		color: var(--color-muted);
	}

	.profile-header h1 {
		margin-bottom: 0.15em;
	}

	.links {
		list-style: none;
		margin: 0.75rem 0 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.links a {
		display: block;
		font-size: 0.85rem;
		font-weight: 600;
		text-decoration: none;
		border: 1px solid var(--color-line);
		border-radius: 999px;
		padding: 0.35rem 0.85rem;
	}

	.links a:hover {
		border-color: var(--color-accent);
	}

	.interests {
		list-style: none;
		margin: 0 0 1.5rem;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.interests li {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--color-muted);
		border: 1px solid var(--color-line);
		border-radius: 999px;
		padding: 0.3rem 0.75rem;
	}
</style>
