---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PublicationCard from '../../components/PublicationCard.astro';
import ResourceCard from '../../components/ResourceCard.astro';
import FilterTabs from '../../components/FilterTabs.astro';

const settings = await getEntry('siteSettings', 'main');
const publications = await getCollection('publications');
const resources = await getCollection('ressources');

const filters = [
	{ label: 'Tous', url: '/ressources/' },
	{ label: 'Publications', url: '/ressources/publications/' },
	{ label: 'Audiovisuelles', url: '/ressources/audiovisuelles/' },
	{ label: 'Pédagogiques', url: '/ressources/pedagogiques/' },
];
---

<BaseLayout title={`Ressources — ${settings?.data.siteName}`}>
	<section class="section">
		<div class="wrap">
			<h1>Ressources</h1>
			<FilterTabs items={filters} />

			<h2>Publications</h2>
			<div class="card-grid">
				{publications.map((publication) => <PublicationCard publication={publication} />)}
			</div>

			<h2>Autres ressources</h2>
			<div class="card-grid">
				{resources.map((resource) => <ResourceCard resource={resource} />)}
			</div>
		</div>
	</section>
</BaseLayout>
