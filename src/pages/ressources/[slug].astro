---
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../lib/url';
import { youtubeEmbedUrl } from '../../lib/youtube';
import { languageLabel } from '../../lib/language';

export async function getStaticPaths() {
	const resources = await getCollection('ressources');
	return resources.map((resource) => ({
		params: { slug: resource.id },
		props: { resource },
	}));
}

const { resource } = Astro.props;
const { Content } = await render(resource);
const type = await getEntry('resourceTypes', resource.data.type);

const embedUrl = resource.data.youtubeUrl ? youtubeEmbedUrl(resource.data.youtubeUrl) : undefined;
const downloadLink = resource.data.externalUrl ?? (resource.data.file ? withBase(resource.data.file) : undefined);
---

<BaseLayout
	title={resource.data.title}
	description={resource.data.description}
	breadcrumb={[{ label: 'Ressources', url: '/ressources/' }, { label: resource.data.title }]}
>
	<article class="section wrap-prose">
		<p class="eyebrow">
			{type?.data.label ?? resource.data.type}
			<span class="lang-badge">{languageLabel(resource.data.language)}</span>
		</p>
		<h1>{resource.data.title}</h1>
		{resource.data.authors.length > 0 && <p class="meta">{resource.data.authors.join(', ')}</p>}
		{
			resource.data.thumbnail && !embedUrl && (
				<div class="detail-image">
					<img src={withBase(resource.data.thumbnail)} alt="" />
				</div>
			)
		}
		{
			embedUrl && (
				<div class="video-embed">
					<iframe
						src={embedUrl}
						title={resource.data.title}
						loading="lazy"
						allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
						allowfullscreen
					/>
				</div>
			)
		}
		{resource.data.audioUrl && <audio controls src={resource.data.audioUrl} />}
		{resource.data.description && <p>{resource.data.description}</p>}
		<div class="prose">
			<Content />
		</div>
		{
			downloadLink && (
				<p>
					<a class="btn" href={downloadLink}>
						Accéder à la ressource
					</a>
				</p>
			)
		}
	</article>
</BaseLayout>

<style>
	.video-embed {
		position: relative;
		aspect-ratio: 16 / 9;
		margin-block: 1.5rem;
		border-radius: var(--radius);
		overflow: hidden;
	}

	.video-embed iframe {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		border: 0;
	}

	audio {
		display: block;
		margin-block: 1.25rem;
	}

	.lang-badge {
		font-family: var(--font-mono);
		font-size: 0.68rem;
		font-weight: 600;
		letter-spacing: 0.03em;
		color: var(--color-muted);
		border: 1px solid var(--color-line);
		border-radius: 999px;
		padding: 0.1rem 0.5rem;
		margin-left: 0.5rem;
	}
</style>
