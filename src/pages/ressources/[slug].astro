---
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
	const resources = await getCollection('ressources');
	return resources.map((resource) => ({
		params: { slug: resource.id },
		props: { resource },
	}));
}

const { resource } = Astro.props;
const { Content } = await render(resource);
const type = await getEntry('resourceTypes', resource.data.type);
const externalLink = resource.data.externalUrl ?? resource.data.youtubeUrl ?? resource.data.audioUrl ?? resource.data.file;
---

<BaseLayout title={resource.data.title} description={resource.data.description}>
	<article class="section wrap">
		<p class="eyebrow">{type?.data.label ?? resource.data.type}</p>
		<h1>{resource.data.title}</h1>
		{resource.data.authors.length > 0 && <p class="meta">{resource.data.authors.join(', ')}</p>}
		{resource.data.description && <p>{resource.data.description}</p>}
		<div class="prose">
			<Content />
		</div>
		{
			externalLink && (
				<p>
					<a class="btn" href={externalLink}>
						Accéder à la ressource
					</a>
				</p>
			)
		}
	</article>
</BaseLayout>
