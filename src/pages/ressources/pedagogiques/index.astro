---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ResourceCard from '../../../components/ResourceCard.astro';
import FilterTabs from '../../../components/FilterTabs.astro';

const settings = await getEntry('siteSettings', 'main');
const resources = await getCollection('ressources', ({ data }) => data.type === 'pedagogical');

const filters = [
	{ label: 'Tous', url: '/ressources/' },
	{ label: 'Publications', url: '/ressources/publications/' },
	{ label: 'Audiovisuelles', url: '/ressources/audiovisuelles/' },
	{ label: 'Pédagogiques', url: '/ressources/pedagogiques/' },
];
---

<BaseLayout
	title={`Ressources pédagogiques — ${settings?.data.siteName}`}
	breadcrumb={[{ label: 'Ressources', url: '/ressources/' }, { label: 'Pédagogiques' }]}
>
	<section class="section">
		<div class="wrap">
			<h1>Ressources</h1>
			<FilterTabs items={filters} />
			<h2>Pédagogiques</h2>
			{
				resources.length > 0 ? (
					<div class="card-grid">
						{resources.map((resource) => (
							<ResourceCard resource={resource} />
						))}
					</div>
				) : (
					<p>Aucune ressource pédagogique publiée pour le moment.</p>
				)
			}
		</div>
	</section>
</BaseLayout>
