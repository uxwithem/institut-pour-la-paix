---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import EventCard from '../../components/EventCard.astro';
import FilterTabs from '../../components/FilterTabs.astro';

const settings = await getEntry('siteSettings', 'main');
const now = new Date();
const events = await getCollection('evenements');

const past = events
	.filter((e) => e.data.startDate < now)
	.sort((a, b) => b.data.startDate.valueOf() - a.data.startDate.valueOf());

const filters = [
	{ label: 'À venir', url: '/agenda/' },
	{ label: 'Passés', url: '/agenda/passes/' },
];
---

<BaseLayout title={`Événements passés — Agenda — ${settings?.data.siteName}`}>
	<section class="section">
		<div class="wrap">
			<h1>Agenda</h1>
			<FilterTabs items={filters} />
			<div class="card-grid">
				{past.map((event) => <EventCard event={event} />)}
			</div>
		</div>
	</section>
</BaseLayout>
