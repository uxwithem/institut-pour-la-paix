---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import EventCard from '../../components/EventCard.astro';
import FilterTabs from '../../components/FilterTabs.astro';

const settings = await getEntry('siteSettings', 'main');
const now = new Date();
const events = await getCollection('evenements');

const upcoming = events
	.filter((e) => e.data.startDate >= now)
	.sort((a, b) => a.data.startDate.valueOf() - b.data.startDate.valueOf());
const hasPast = events.some((e) => e.data.startDate < now);

const filters = [
	{ label: 'À venir', url: '/agenda/' },
	...(hasPast ? [{ label: 'Passés', url: '/agenda/passes/' }] : []),
];
---

<BaseLayout title={`Agenda — ${settings?.data.siteName}`} breadcrumb={[{ label: 'Agenda' }]}>
	<section class="section">
		<div class="wrap">
			<h1>Agenda</h1>
			<FilterTabs items={filters} />
			{
				upcoming.length > 0 ? (
					<div class="card-grid">
						{upcoming.map((event) => (
							<EventCard event={event} />
						))}
					</div>
				) : (
					<p>Aucun événement à venir.</p>
				)
			}
		</div>
	</section>
</BaseLayout>
