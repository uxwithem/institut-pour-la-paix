---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ResearchGroupCard from '../components/ResearchGroupCard.astro';
import ArticleCard from '../components/ArticleCard.astro';
import EventCard from '../components/EventCard.astro';
import ResourceCard from '../components/ResourceCard.astro';
import { withBase } from '../lib/url';

const settings = await getEntry('siteSettings', 'main');

const groups = (await getCollection('groupes', ({ data }) => data.status === 'active')).slice(0, 5);

const articles = (await getCollection('actualites')).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const latestArticles = articles.slice(0, 4);

const now = new Date();
const upcomingEvents = (await getCollection('evenements'))
	.filter((e) => e.data.startDate >= now && !e.data.cancelled)
	.sort((a, b) => a.data.startDate.valueOf() - b.data.startDate.valueOf())
	.slice(0, 4);

const latestResources = (await getCollection('ressources'))
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
	.slice(0, 4);
---

<BaseLayout title={settings?.data.tagline ?? settings?.data.siteName ?? 'Accueil'}>
	<section class="hero">
		<div class="wrap hero-inner">
			<p class="eyebrow eyebrow-light">{settings?.data.siteName}</p>
			<h1>Une paix durable. Par la recherche, par l'action.</h1>
			<p class="lead">{settings?.data.description}</p>
		</div>
	</section>

	<section class="pillars">
		<a class="pillar" href={withBase('/recherche/')}>
			<span class="pillar-index">01</span>
			<h2>Recherche</h2>
			<p>Cinq groupes de recherche, des publications, des actualités sur la paix comme objet d'étude.</p>
			<span class="pillar-go">Explorer la recherche →</span>
		</a>
		<a class="pillar pillar-action" href={withBase('/agenda/')}>
			<span class="pillar-index">02</span>
			<h2>Agir</h2>
			<p>Participez à nos événements, rejoignez le réseau, devenez membre de l'Institut.</p>
			<span class="pillar-go">Voir l'agenda →</span>
		</a>
	</section>

	<section class="section">
		<div class="wrap">
			<h2>Nos groupes de recherche</h2>
			<div class="filmstrip">
				{groups.map((group) => <ResearchGroupCard group={group} />)}
			</div>
		</div>
	</section>

	{
		latestArticles.length > 0 && (
			<section class="section">
				<div class="wrap">
					<h2>À la une</h2>
					<div class="filmstrip">
						{latestArticles.map((article) => (
							<ArticleCard article={article} />
						))}
					</div>
					<p class="more">
						<a href={withBase('/actualites/')}>Toutes les actualités →</a>
					</p>
				</div>
			</section>
		)
	}

	<section class="section">
		<div class="wrap">
			<h2>Agenda</h2>
			{
				upcomingEvents.length > 0 ? (
					<div class="filmstrip">
						{upcomingEvents.map((event) => (
							<EventCard event={event} />
						))}
					</div>
				) : (
					<p>Aucun événement à venir.</p>
				)
			}
			<p class="more">
				<a href={withBase('/agenda/')}>Voir tout l'agenda →</a>
			</p>
		</div>
	</section>

	{
		latestResources.length > 0 && (
			<section class="section">
				<div class="wrap">
					<h2>Ressources</h2>
					<div class="filmstrip">
						{latestResources.map((resource) => (
							<ResourceCard resource={resource} />
						))}
					</div>
					<p class="more">
						<a href={withBase('/ressources/')}>Toutes les ressources →</a>
					</p>
				</div>
			</section>
		)
	}

	<section class="cta">
		<div class="wrap">
			<h2>Rejoindre le réseau</h2>
			<p>Devenez membre de l'Institut pour la Paix.</p>
			<a class="btn" href={withBase('/devenir-membre/')}>Devenir membre</a>
		</div>
	</section>
</BaseLayout>

<style>
	.hero {
		background: var(--color-indigo);
		color: #fff;
	}

	.hero :focus-visible,
	.cta :focus-visible,
	.pillar-action:focus-visible {
		outline-color: var(--color-signal-bright);
	}

	.hero-inner {
		padding-block: var(--space-5) var(--space-4);
	}

	@media (min-width: 48rem) {
		.hero-inner {
			padding-block: 6rem;
		}
	}

	.eyebrow-light {
		color: #cfccee;
	}

	.hero h1 {
		color: #fff;
		max-width: 24ch;
	}

	.hero .lead {
		max-width: 38rem;
		color: #ded9f6;
		font-size: 1.1rem;
	}

	.pillars {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1px;
		background: var(--color-line);
		border-bottom: 1px solid var(--color-line);
	}

	@media (min-width: 40rem) {
		.pillars {
			grid-template-columns: 1fr 1fr;
		}
	}

	.pillar {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		background: var(--color-surface);
		padding: var(--space-3) 1.25rem var(--space-4);
		text-decoration: none;
		color: var(--color-ink);
	}

	@media (min-width: 48rem) {
		.pillar {
			padding: var(--space-4) 2rem var(--space-5);
		}
	}

	.pillar:hover {
		background: var(--color-paper);
		color: var(--color-ink);
	}

	.pillar-action {
		background: var(--color-indigo);
		color: #fff;
	}

	.pillar-action:hover {
		background: var(--color-indigo-deep);
		color: #fff;
	}

	.pillar-index {
		font-family: var(--font-mono);
		font-size: 0.8rem;
		color: var(--color-signal);
	}

	.pillar-action .pillar-index {
		color: var(--color-signal-bright);
	}

	.pillar h2 {
		margin: 0;
	}

	.pillar p {
		margin: 0;
		max-width: 32ch;
	}

	.pillar-action p {
		color: #ded9f6;
	}

	.pillar-go {
		margin-top: 0.5rem;
		font-weight: 600;
		font-size: 0.92rem;
	}

	.more {
		margin-top: 1.25rem;
	}

	.more a {
		font-weight: 600;
		text-decoration: none;
	}

	.cta {
		background: var(--color-indigo-deep);
		color: #fff;
		text-align: center;
		padding-block: var(--space-5);
	}

	.cta h2 {
		color: #fff;
	}

	.cta p {
		color: #ded9f6;
		margin-bottom: 1.75rem;
	}
</style>
