---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import EventCard from '../components/EventCard.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import { withBase } from '../lib/url';
import { youtubeEmbedUrl } from '../lib/youtube';

const settings = await getEntry('siteSettings', 'main');
const presentationVideo = settings?.data.presentationVideoUrl
	? youtubeEmbedUrl(settings.data.presentationVideoUrl)
	: undefined;

const articles = (await getCollection('actualites')).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const latestArticles = articles.slice(0, 3);

const now = new Date();
const upcomingEvents = (await getCollection('evenements'))
	.filter((e) => e.data.startDate >= now && !e.data.cancelled)
	.sort((a, b) => a.data.startDate.valueOf() - b.data.startDate.valueOf())
	.slice(0, 3);
---

<BaseLayout title={settings?.data.tagline ?? settings?.data.siteName ?? 'Accueil'}>
	<section class="hero">
		<div class="wrap hero-inner">
			<p class="eyebrow eyebrow-light">{settings?.data.siteName}</p>
			<h1>Une paix durable. Par la recherche, par l'action.</h1>
			<p class="lead">{settings?.data.description}</p>
		</div>
	</section>

	<section class="pillars">
		<a class="pillar" href={withBase('/recherche/')}>
			<span class="pillar-index">01</span>
			<h2>Recherche</h2>
			<p>Cinq groupes de recherche, des publications, des actualités sur la paix comme objet d'étude.</p>
			<span class="pillar-go">Explorer la recherche →</span>
		</a>
		<a class="pillar pillar-action" href={withBase('/agenda/')}>
			<span class="pillar-index">02</span>
			<h2>Agir</h2>
			<p>Participez à nos événements, rejoignez le réseau, devenez membre de l'Institut.</p>
			<span class="pillar-go">Voir l'agenda →</span>
		</a>
	</section>

	{
		latestArticles.length > 0 && (
			<section class="section">
				<div class="wrap">
					<h2>À la une</h2>
					<div class="filmstrip">
						{latestArticles.map((article) => (
							<ArticleCard article={article} />
						))}
					</div>
					<p class="more">
						<a href={withBase('/actualites/')}>Toutes les actualités →</a>
					</p>
				</div>
			</section>
		)
	}

	<section class="section">
		<div class="wrap">
			<h2>Agenda</h2>
			{
				upcomingEvents.length > 0 ? (
					<div class="filmstrip">
						{upcomingEvents.map((event) => (
							<EventCard event={event} />
						))}
					</div>
				) : (
					<p>Aucun événement à venir.</p>
				)
			}
			<p class="more">
				<a href={withBase('/agenda/')}>Voir tout l'agenda →</a>
			</p>
		</div>
	</section>

	{
		presentationVideo && (
			<section class="section">
				<div class="wrap video-grid">
					<div>
						<h2>L'IPP en 3 minutes</h2>
						{settings?.data.presentationVideoCaption && <p>{settings.data.presentationVideoCaption}</p>}
						<a class="btn" href={withBase('/devenir-membre/')}>
							Devenez membre
						</a>
					</div>
					<div class="video-embed">
						<iframe
							src={presentationVideo}
							title="L'IPP en 3 minutes"
							loading="lazy"
							allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
							allowfullscreen
						/>
					</div>
				</div>
			</section>
		)
	}

	<section class="cta">
		<div class="wrap">
			<NewsletterForm />
		</div>
	</section>
</BaseLayout>

<style>
	.video-grid {
		display: grid;
		gap: 2rem;
		align-items: center;
	}

	@media (min-width: 48rem) {
		.video-grid {
			grid-template-columns: 1fr 1fr;
			gap: 3rem;
		}
	}

	.video-embed {
		position: relative;
		aspect-ratio: 16 / 9;
		border-radius: var(--radius);
		overflow: hidden;
	}

	.video-embed iframe {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		border: 0;
	}

	.hero {
		background: var(--gradient-ink);
		color: var(--color-bg);
		display: flex;
		align-items: center;
		min-height: 100svh;
	}

	.hero :focus-visible,
	.cta :focus-visible,
	.pillar-action:focus-visible {
		outline-color: var(--color-accent);
	}

	.hero-inner {
		padding-block: var(--space-5);
	}

	@media (min-width: 48rem) {
		.hero {
			min-height: 80svh;
		}
	}

	.eyebrow-light {
		color: color-mix(in srgb, var(--color-bg) 70%, var(--color-fg));
	}

	.hero h1 {
		color: var(--color-bg);
		max-width: 24ch;
	}

	.hero .lead {
		max-width: 38rem;
		color: color-mix(in srgb, var(--color-bg) 85%, var(--color-fg));
		font-size: 1.1rem;
	}

	.pillars {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1px;
		background: var(--color-line);
		border-bottom: 1px solid var(--color-line);
	}

	@media (min-width: 40rem) {
		.pillars {
			grid-template-columns: 1fr 1fr;
		}
	}

	.pillar {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		background: var(--color-surface);
		padding: var(--space-3) 1.25rem var(--space-4);
		text-decoration: none;
		color: var(--color-fg);
	}

	@media (min-width: 48rem) {
		.pillar {
			padding: var(--space-4) 2rem var(--space-5);
		}
	}

	.pillar:hover {
		background: var(--color-bg);
		color: var(--color-fg);
	}

	.pillar-action {
		background: var(--gradient-ink);
		color: var(--color-bg);
	}

	.pillar-action:hover {
		background: var(--gradient-ink);
		filter: brightness(1.08);
		color: var(--color-bg);
	}

	.pillar-index {
		font-family: var(--font-mono);
		font-size: 0.8rem;
		color: var(--color-accent);
	}

	.pillar h2 {
		margin: 0;
	}

	.pillar p {
		margin: 0;
		max-width: 32ch;
	}

	.pillar-action p {
		color: color-mix(in srgb, var(--color-bg) 85%, var(--color-fg));
	}

	.pillar-go {
		margin-top: 0.5rem;
		font-weight: 600;
		font-size: 0.92rem;
	}

	.more {
		margin-top: 1.25rem;
	}

	.more a {
		font-weight: 600;
		text-decoration: none;
	}

	.cta {
		background: var(--gradient-ink);
		color: var(--color-bg);
		text-align: center;
		padding-block: var(--space-5);
	}

	.cta h2 {
		color: var(--color-bg);
	}

	.cta p {
		color: color-mix(in srgb, var(--color-bg) 85%, var(--color-fg));
		margin-bottom: 1.75rem;
	}
</style>
